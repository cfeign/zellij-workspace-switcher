# Ghostty settings that matter for this workspace.
# Ghostty reads ~/.config/ghostty/config. Merge these lines into yours, or
# copy this file there if you have none. Reload with Cmd+Shift+, on macOS.

# REQUIRED on macOS. Without it, Option+1 types "¡" instead of sending Alt+1
# to Zellij, and every Alt binding in config.kdl is dead.
macos-option-as-alt = true

# Nerd Font so pane titles, prompts and icons render. Any Nerd Font works.
font-family = JetBrainsMono Nerd Font
font-size = 13

# Launch straight into the workspace. Remove this line to get a plain shell
# and start it by hand with `zellij-workspace start`.
command = /opt/homebrew/bin/fish -c "zellij-workspace start"

# Ghostty's own keybinds take precedence over Zellij. These are the defaults
# that collide with the workspace bindings; unbind or move them if you hit
# conflicts. (Cmd keys never reach the terminal, so Cmd shortcuts are safe.)
#keybind = alt+left=unbind
#keybind = alt+right=unbind

# Nice to have
window-padding-x = 4
window-padding-y = 2
confirm-close-surface = false
